# Server --------------------------------------------------------------------
# Data source: "opensky" (real ADS-B, free, no receiver) | "radio" (dump1090) |
#              "api" (airplanes.live) | "adsbfi" (opendata.adsb.fi). No mock.
DATA_SOURCE=opensky

# dump1090-fa aircraft.json feed (used when DATA_SOURCE=radio).
AIRCRAFT_JSON_URL=http://localhost:8080/data/aircraft.json

# airplanes.live point query template. {lat}/{lon}/{r} are filled from config.
API_URL=https://api.airplanes.live/v2/point/{lat}/{lon}/{r}

# adsb.fi open-data point query. {lat}/{lon}/{nm} are filled from config
# (nm = nautical miles, capped at 250 by the API). Used by the "adsbfi" source.
ADSB_FI_URL=https://opendata.adsb.fi/api/v3/lat/{lat}/lon/{lon}/dist/{nm}

# Merge the API too when on radio (keeps landing aircraft alive).
SUPPLEMENT_API=0

# HTTP + WebSocket port.
PORT=3000
HOST=0.0.0.0

# Poll cadence (ms). Kept relaxed to respect free API rate limits; the client
# extrapolates aircraft trajectories between updates so motion stays smooth.
POLL_MS=8000
API_POLL_MS=8000

# Nominatim user agent (identify your deployment).
GEOCODE_USER_AGENT=skyview-3d/0.1 (https://github.com/skyview-3d)

# Frontend ------------------------------------------------------------------
VITE_SERVER_URL=ws://localhost:3000
VITE_API_BASE=http://localhost:3000/api
VITE_DEFAULT_LAT=48.8566
VITE_DEFAULT_LON=2.3522
VITE_DEFAULT_RADIUS=50
VITE_AIRCRAFT_MODEL=glyphs
VITE_LOG_LEVEL=info
