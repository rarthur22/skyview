# Web frontend environment (optional). Endpoints derive from the page origin in
# most cases; set these to override (e.g. when the server runs on a custom port).

VITE_SERVER_URL=ws://localhost:3000/ws
VITE_API_BASE=http://localhost:3000/api

# Defaults for initial config.
VITE_DEFAULT_LAT=48.8566
VITE_DEFAULT_LON=2.3522
VITE_DEFAULT_RADIUS=25

# Initial display mode: glyphs | glb | mesh
VITE_AIRCRAFT_MODEL=glb

VITE_LOG_LEVEL=info
